<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.azuretek.cuate.helper</string>
  <key>CFBundleName</key><string>Cuate Helper</string>
  <key>CFBundleDisplayName</key><string>Cuate Helper</string>
  <key>CFBundleExecutable</key><string>cuate-helper</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>CuateCommit</key><string>@COMMIT@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSContactsUsageDescription</key><string>Cuate Helper reads your contacts so Cuate can show names and photos instead of phone numbers and addresses.</string>
  <key>NSAppleEventsUsageDescription</key><string>Cuate Helper asks Messages to send the messages and reactions you write in Cuate.</string>
</dict>
</plist>
