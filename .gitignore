node_modules/
out/
dist/
coverage/
*.log
.DS_Store
.cache/
release-assets/
artifacts/

# The server's version stamp: scripts/gen-server-stamp.mjs writes it into a built server, and a development
# checkout reports core/spec/version.json without one.
server/stamp.json

# The generated Xcode project and the simulator build output: both are produced
# by xcodegen and xcodebuild, so neither is source.
ios/build/
ios/Cuate.xcodeproj/
ios/proof/
ios/*.xcuserdata/
ios/SourcePackages/

# The Python bytecode the release scripts leave behind when they run: it is
# never source, and the pipeline runs the scripts from the checkout each time.
__pycache__/
*.pyc

# The Android build output and the copied core tree: Gradle produces both, so
# neither is source. The boot proof is captured in CI and committed under
# docs/proof instead.
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/proof/
