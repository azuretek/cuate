<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The page is served from the APK's own assets, so nothing here needs the
         network yet; the permission is declared for the server connection the
         screens land next. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updating in the app (issue 192): a verified release APK is handed to the system installer, which asks the
         person to confirm. Android asks once whether this app may install apps, after the app has said why. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cuate"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cuate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The installer's answer to an update this app handed it. Not exported: only the PendingIntent the app made
             reaches it, so nothing outside the app can hand it an intent to start. -->
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />
    </application>

</manifest>
