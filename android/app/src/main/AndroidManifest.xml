<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The page is served from the APK's own assets, so nothing here needs the
         network yet; the permission is declared for the server connection the
         screens land next. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updating in the app (issue 192): a verified release APK is handed to the system installer, which asks the
         person to confirm. Android asks once whether this app may install apps, after the app has said why. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cuate"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cuate" />

        <!-- The launcher entries, one per app icon Settings offers (core/spec/app-icons.json, issue 167). Each is an
             alias of the one activity wearing its own icon; only Follow theme (the store icon, drawn in the
             default theme) is enabled in a fresh install, and the bridge's app.icon enables the chosen one and
             disables the rest (HostBridge.kt). The activity itself is never disabled, so a change never closes the
             app. core/test/settings-tabs.test.js holds this list to the
             spec. -->
        <activity-alias
            android:name=".AppIcon_theme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_naranja_light"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_naranja_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_naranja_dark"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_naranja_dark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_azul_light"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_azul_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_azul_dark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_azul_dark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_rosa_light"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rosa_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_rosa_dark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rosa_dark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_jade_light"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_jade_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_jade_dark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_jade_dark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_morado_light"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_morado_light"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AppIcon_morado_dark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_morado_dark"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The installer's answer to an update this app handed it. Not exported: only the PendingIntent the app made
             reaches it, so nothing outside the app can hand it an intent to start. -->
        <receiver
            android:name=".InstallStatusReceiver"
            android:exported="false" />

        <!-- A document pressed in a conversation (issue 219) is written to the app's cache and shared through this
             provider, so the system's share sheet (which includes Save to Files) can read it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
