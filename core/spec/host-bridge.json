{
  "description": "Every command a page may call on the shell that hosts it, as window.bridge.call(name, args), and every event the shell may send the page, as window.bridge.on(name, handler). Each shell implements exactly these and refuses anything else (desktop/test/bridge.test.js). A platform difference is data here, never a branch in core.",
  "commands": {
    "storage.get": { "args": { "key": "string" }, "returns": "string?" },
    "storage.set": { "args": { "key": "string", "value": "string" }, "returns": "boolean" },
    "storage.delete": { "args": { "key": "string" }, "returns": "boolean" },
    "app.info": { "args": {}, "returns": "AppInfo" },
    "notify": { "args": { "title": "string", "body": "string" }, "returns": "boolean" },
    "open.external": { "args": { "url": "string" }, "returns": "boolean" },
    "updates.check": { "args": {}, "returns": "UpdateState?" },
    "updates.releases": { "args": {}, "returns": "string?" },
    "updates.configure": { "args": { "autoDownload": "boolean" }, "returns": "boolean" },
    "updates.download": { "args": { "version": "string?" }, "returns": "boolean" },
    "updates.install": { "args": {}, "returns": "boolean" },
    "window.minimize": { "args": {}, "returns": "boolean" },
    "window.toggleMaximize": { "args": {}, "returns": "boolean" },
    "window.close": { "args": {}, "returns": "boolean" },
    "window.appearance": { "args": { "scheme": "string", "background": "string" }, "returns": "boolean" }
  },
  "events": {
    "update.state": { "args": { "state": "string", "version": "string?", "percent": "number?", "detail": "string?", "canInstall": "boolean?", "via": "string?", "transferred": "number?", "total": "number?" }, "returns": "void", "states": ["checking", "available", "downloading", "stalled", "ready", "error", "current", "unsupported"] },
    "window.state": { "args": { "maximized": "boolean" }, "returns": "void" },
    "app.open": { "args": { "screen": "string" }, "returns": "void", "screens": ["settings", "about", "updates"] }
  }
}
