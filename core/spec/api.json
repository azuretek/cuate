{
  "description": "The one owner of the contract between the clients and the server: every route, scope, event and payload. The server's routes and the client's calls are both tested against it (server/test/api.test.js). A payload key not declared here fails the test.",
  "version": 1,
  "scopes": {
    "device": ["read", "send", "settings"],
    "tooling": ["read", "search", "export", "metrics"],
    "admin": ["read", "send", "search", "export", "metrics", "admin", "settings"]
  },
  "uploads": { "maxBytes": 104857600, "keepHours": 24 },
  "paging": {
    "chats": { "default": 200, "max": 500 },
    "messages": { "default": 50, "max": 200 },
    "search": { "default": 50, "max": 200 }
  },
  "routes": [
    { "id": "health", "method": "GET", "path": "/healthz", "scope": "none", "returns": "Health" },
    { "id": "openapi", "method": "GET", "path": "/openapi.json", "scope": "none", "returns": "object" },
    { "id": "mcp", "method": "POST", "path": "/api/v1/mcp", "scope": "any", "returns": "object" },
    { "id": "info", "method": "GET", "path": "/api/v1/info", "scope": "any", "returns": "Info" },
    { "id": "chats", "method": "GET", "path": "/api/v1/chats", "scope": "read", "query": ["limit"], "returns": "ChatList" },
    { "id": "messages", "method": "GET", "path": "/api/v1/chats/:chatId/messages", "scope": "read", "query": ["limit", "before"], "returns": "MessageList" },
    { "id": "send", "method": "POST", "path": "/api/v1/chats/:chatId/messages", "scope": "send", "body": "SendRequest", "returns": "SendResult" },
    { "id": "react", "method": "POST", "path": "/api/v1/chats/:chatId/messages/:messageId/reactions", "scope": "send", "body": "ReactionRequest", "returns": "ReactionResult" },
    { "id": "upload", "method": "POST", "path": "/api/v1/attachments", "scope": "send", "body": "UploadRequest", "returns": "Attachment" },
    { "id": "read", "method": "POST", "path": "/api/v1/chats/:chatId/read", "scope": "send", "returns": "ChatRead" },
    { "id": "attachment", "method": "GET", "path": "/api/v1/attachments/:attachmentId", "scope": "read", "query": ["format"], "returns": "binary" },
    { "id": "search", "method": "GET", "path": "/api/v1/search", "scope": "search", "query": ["q", "limit", "chatId"], "returns": "SearchResults" },
    { "id": "settings", "method": "GET", "path": "/api/v1/settings", "scope": "read", "returns": "Settings" },
    { "id": "settings-write", "method": "PUT", "path": "/api/v1/settings", "scope": "settings", "body": "SettingsPatch", "returns": "Settings" },
    { "id": "theme-import", "method": "POST", "path": "/api/v1/themes", "scope": "settings", "body": "ThemeImportRequest", "returns": "ThemeImportResult" },
    { "id": "mac", "method": "GET", "path": "/api/v1/mac", "scope": "read", "returns": "MacState" },
    { "id": "mac-restart", "method": "POST", "path": "/api/v1/mac/restart", "scope": "admin", "body": "MacRestartRequest", "returns": "MacRestartResult" },
    { "id": "export", "method": "GET", "path": "/api/v1/export", "scope": "export", "query": ["mode"], "returns": "object" }
  ],
  "websocket": {
    "path": "/api/v1/events",
    "scope": "read",
    "clientFrames": { "auth": { "token": "string", "resume": "Resume?" } },
    "serverFrames": { "hello": "Hello", "event": "EventFrame" }
  },
  "events": {
    "message.new": "MessageEvent",
    "reaction": "ReactionEvent",
    "chat.read": "ChatRead",
    "server.state": "ServerState",
    "settings.changed": "SettingsEvent",
    "mac.state": "MacEvent",
    "server.update": "ServerUpdate"
  },
  "models": {
    "Health": { "ok": "boolean", "version": "string", "commit": "string?" },
    "Info": { "product": "string", "apiVersion": "number", "serverVersion": "string", "serverChannel": "string", "serverBuild": "string?", "serverCommit": "string?", "serverBuiltAt": "string?", "serverPlatform": "string", "epoch": "string", "engine": "EngineInfo", "sending": "boolean", "uploadMaxBytes": "number", "serverUpdate": "ServerUpdate?" },
    "EngineInfo": { "kind": "string", "version": "string?", "ready": "boolean" },
    "ChatList": { "chats": "Chat[]" },
    "Chat": { "id": "string", "name": "string", "isGroup": "boolean", "service": "string", "participants": "string[]", "unread": "number", "lastMessageAt": "string?", "lastMessage": "Preview?" },
    "Preview": { "text": "string", "fromMe": "boolean", "sentAt": "string", "attachments": "number" },
    "MessageList": { "messages": "Message[]", "hasMore": "boolean" },
    "Message": { "id": "string", "chatId": "string", "fromMe": "boolean", "sender": "string?", "senderName": "string?", "text": "string", "sentAt": "string", "replyTo": "string?", "read": "boolean?", "attachments": "Attachment[]", "reactions": "Reaction[]" },
    "Attachment": { "id": "string", "name": "string", "mime": "string", "bytes": "number", "sticker": "boolean", "missing": "boolean" },
    "Reaction": { "type": "string", "emoji": "string?", "fromMe": "boolean", "sender": "string?" },
    "SendRequest": { "text": "string?", "file": "string?", "clientKey": "string", "replyTo": "string?" },
    "ReactionRequest": { "emoji": "string", "remove": "boolean?" },
    "ReactionResult": { "status": "string", "targetId": "string", "type": "string", "add": "boolean" },
    "UploadRequest": { "name": "string", "mime": "string?", "data": "string" },
    "SendResult": { "status": "string", "clientKey": "string", "messageId": "string?", "duplicate": "boolean?" },
    "ChatRead": { "chatId": "string", "unread": "number" },
    "SearchResults": { "query": "string", "results": "SearchResult[]" },
    "SearchResult": { "chatId": "string", "chatName": "string", "message": "Message" },
    "Settings": { "values": "object" },
    "SettingsPatch": { "values": "object" },
    "SettingsEvent": { "values": "object" },
    "ThemeImportRequest": { "url": "string", "name": "string?" },
    "ThemeImportResult": { "theme": "object", "accepted": "string[]", "refused": "string[]", "summary": "string", "values": "object" },
    "MacState": { "awake": "boolean", "locked": "boolean", "lockEnabled": "boolean", "lockMethod": "string", "messagesRunning": "boolean", "managedBy": "string?" },
    "MacRestartRequest": { "what": "string" },
    "MacRestartResult": { "what": "string", "restarted": "boolean", "reason": "string?" },
    "MacEvent": { "name": "string", "what": "string?", "on": "boolean?", "locked": "boolean?", "reason": "string?" },
    "Resume": { "epoch": "string", "seq": "number" },
    "Hello": { "type": "string", "epoch": "string", "seq": "number", "apiVersion": "number", "resumed": "boolean" },
    "EventFrame": { "type": "string", "seq": "number", "name": "string", "data": "object" },
    "MessageEvent": { "message": "Message" },
    "ReactionEvent": { "chatId": "string", "targetId": "string", "type": "string", "emoji": "string?", "add": "boolean", "fromMe": "boolean", "sender": "string?" },
    "ServerState": { "engine": "string", "sending": "boolean" },
    "ServerUpdate": { "state": "string", "version": "string?", "from": "string?", "detail": "string?", "at": "string" },
    "Error": { "error": "ErrorBody" },
    "ErrorBody": { "code": "string", "message": "string" }
  }
}
